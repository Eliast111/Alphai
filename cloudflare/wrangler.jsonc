{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alphai-ultra",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
