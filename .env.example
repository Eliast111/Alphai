# Copia estes valores para as Environment Variables da Vercel.
# Não coloques segredos neste ficheiro nem os envies para o GitHub.

FIREBASE_DATABASE_URL=https://alpha-98bb1-default-rtdb.firebaseio.com
HTTP_TIMEOUT=8
MAX_MEMORY_ITEMS=300

# Google Gemini. Guardar apenas nas variáveis de ambiente do servidor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Define um token forte e privado para permitir "ensina: pergunta | resposta".
ALPHAI_ADMIN_TOKEN=
